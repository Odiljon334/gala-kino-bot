# ==========================================
# KINOCHI BOT PRO — SOZLAMALAR FAYLI (.env)
# ==========================================

# 1. Telegram Bot Token (@BotFather dan olingan token)
BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# 2. Telegram Bot Username (@ belgisisiz)
BOT_USERNAME=galakinobot

# 3. Asosiy Admin Telegram ID lari (Vergul bilan ajratilgan raqamlar)
ADMIN_IDS=123456789,987654321

# 4. Ma'lumotlar Bazasi Yo'li
DATABASE_PATH=kinochi.db

# 5. Zamonaviy Web Admin Dashboard Sozlamalari
WEB_HOST=0.0.0.0
WEB_PORT=8080
WEB_ADMIN_USERNAME=admin
WEB_ADMIN_PASSWORD=kinochi2026
WEB_SECRET_KEY=kinochi-super-secret-key-2026

# 6. Standart Kunlik Yuklash Limiti (0 = cheksiz)
DEFAULT_DAILY_LIMIT=10

# 7. Vaqt Mintaqasi
TIMEZONE=Asia/Tashkent
